# ==========================================
# MedTrace Environment Configuration Example
# ==========================================

# 1. Zetaris Data Layer (Required Headline Sponsor)
# Optional: alternative REST route. Default is {ZETARIS_BASE_URL}/api/proxy/sql-editor/sqls/run-query
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password
# true = read MEDTRACE_LH via Zetaris (register first: python scripts/register_zetaris_medtrace.py)
USE_ZETARIS=false

# 2. Meterless Nightshift / AI Hotspot (Required Power Layer)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# 3. Model Route for NVIDIA Nemotron
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 4. External Data APIs
OPENFDA_API_KEY=your-api-data-gov-key

# 5. Runtime Behavior
SAMPLE_MODE=false
PORT=8000
LOG_LEVEL=INFO
